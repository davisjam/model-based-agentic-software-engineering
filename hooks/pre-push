#!/usr/bin/env python3
"""pre-push: BUILD the site AND the PDF, then run the fast deterministic gate — before any push.

Four gates, in order, so a change that would fail CI cannot leave the machine:

  1. `catalog.py build` — the actual markdown->HTML + mermaid render. This catches BUILD failures the
     test suite structurally cannot: a notation marker that doesn't head its block, a bad mermaid fence,
     an unregistered `index-def` slug — anything that aborts the render (rc=1). `catalog_tests.py` checks
     ALREADY-BUILT HTML, so it never sees a build abort. This is the gap this hook was strengthened to
     close: a `--no-verify` commit (which skips the pre-commit build) shipped a book-build abort straight
     to CI's "Render markdown -> HTML" step. Now the render runs at pre-push, on `main`, where mmdc is
     installed. (260729 RCA: a mid-block `index-def` aborted CI's build while `--tier1` stayed green.)

  2. `book/build_book.py --pdf` — the print-native Typst render + whole-book content-integrity gate
     (page floor/ceiling, title + chapter/part titles present, tail present, part-opener spread sensor).
     This is the SAME step CI runs on every push (.github/workflows/pages.yml), so a Typst compile error
     or a content-integrity regression is caught on the machine, not three minutes into CI — and the
     gitignored /book/mage-book.pdf refreshes on every push instead of going stale between renders.
     Typst compiles the whole book in a couple of seconds.

  3. `handbook/scripts/build.py pdf` — the supplementary Software Engineering Handbook's Typst PDF
     render (parity with the book PDF). CI renders + publishes it on every push and asserts it
     fatal-if-missing, so a handbook render failure would fail CI; catch it here instead. This also
     refreshes the gitignored local review artifacts (the handbook PDF + the landers staple the pdf
     target emits), so they never go stale between manual handbook builds.

  4. `catalog_tests.py --tier1` — the fast, stdlib, deterministic checks: schema, link + anchor
     resolution, the book/*.html tracking (orphans), the concept-model drift lints (L1/L2/L3), the
     empty-<th> twin, skill bundle integrity. ~seconds.

CI still runs `catalog_tests.py --full` (Tier-2: html-validate + sampled axe + `claude plugin validate`)
as the authoritative gate. Install once with `python3 catalog.py install-hooks` (sets core.hooksPath=hooks).
No shell — pure Python, per the repo's tooling posture.

Bypass (humans, rare — e.g. pushing a WIP branch): `git push --no-verify`.
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def _run(*args: str) -> int:
    return subprocess.run([sys.executable, *args], cwd=ROOT).returncode


print("pre-push: catalog.py build (render gate — catches build aborts CI would hit) …", file=sys.stderr)
if _run("catalog.py", "build"):
    sys.stderr.write(
        "\npre-push: catalog.py build FAILED — push refused.\n"
        "The site does not render; fix the build error above (or `git push --no-verify` to override).\n")
    sys.exit(1)

print("pre-push: book/build_book.py --pdf (Typst PDF render + content-integrity gate CI runs) …", file=sys.stderr)
if _run("book/build_book.py", "--pdf"):
    sys.stderr.write(
        "\npre-push: book/build_book.py --pdf FAILED — push refused.\n"
        "The PDF does not render or fails the content-integrity gate; fix the error above "
        "(or `git push --no-verify` to override).\n")
    sys.exit(1)

# The supplementary Software Engineering Handbook PDF — parity with the book PDF above. CI
# (.github/workflows/pages.yml) renders + publishes it on every push and asserts it fatal-if-missing,
# so a handbook render failure would fail CI; catch it here on the machine instead. `build.py pdf` also
# refreshes the gitignored local review artifacts (dist/software-engineering-handbook.pdf AND the landers
# staple, which the pdf target emits), so they never go stale between manual handbook builds — which is
# why the separate landers-staple refresh that used to live at the end of this hook is now redundant.
print("pre-push: handbook/scripts/build.py pdf (handbook Typst PDF render — parity with the book PDF) …", file=sys.stderr)
if _run("handbook/scripts/build.py", "pdf"):
    sys.stderr.write(
        "\npre-push: handbook/scripts/build.py pdf FAILED — push refused.\n"
        "The handbook PDF does not render; fix the error above (or `git push --no-verify` to override).\n")
    sys.exit(1)

print("pre-push: catalog_tests.py --tier1 (deterministic gate) …", file=sys.stderr)
if _run("catalog_tests.py", "--tier1"):
    sys.stderr.write(
        "\npre-push: catalog_tests.py --tier1 FAILED — push refused.\n"
        "Fix the failing gate(s) above, or `git push --no-verify` to override (rare).\n")
    sys.exit(1)
