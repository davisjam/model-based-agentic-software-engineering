# Generated artifacts — created by scripts/build.py, never hand-edited, never committed.
# Mirrors how the MAGE book gitignores its rendered PDF: the renderers are reproducible, so the
# outputs are created on demand, not tracked.
/generated/
/dist/

# The ePub edition is a binary build artifact wherever it lands (dist/ is already covered above;
# this guards a stray pandoc -o elsewhere under handbook/) — created in CI + at push time, never committed.
*.epub

# Python bytecode from the build/lint scripts.
__pycache__/
*.pyc
