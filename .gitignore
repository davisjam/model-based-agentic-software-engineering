__pycache__/
*.pyc
.DS_Store
# NOTE: /site/ is NO LONGER ignored — it now holds the tracked Teach-with-MAGE MkDocs config
# (mkdocs.yml, requirements.txt, hooks/). Only stray build output under it is ignored (see below).
# catalog.py still lists "site" in NON_SITE_DIRS so it is not scanned as catalogue content.
/_site/
.claude/
plugin/**/*.html
node_modules/

# local-only marketplace-submission blurb (not published, not committed)
/SUBMISSION.md

# internal continuity/handoff docs — kept locally, never shipped to the public repo
/HANDOFF*.md

# local-only book-proposal drafts (not published, not committed)
/BOOK-PROPOSAL*.md

# local scratch (never rendered/served — see catalog.py catalogue_md_files)
*.local.html

# held mechanism drafts (design-stage, not yet promoted) + local-scratch markdown —
# kept locally, never shipped; the guard against a broad `git add -A` sweeping them in
/_drafts/
/book/_drafts/
*.local.md
# EXCEPTION — the local-adapter plug convention repurposes `*.local.md` UNDER the shipped skills as the
# ADOPTER OVERLAY. This repo dogfoods as adopter #0: its own DocAble house dialect ships as the worked
# example (e.g. writing/lexicon.local.md), tracked + vendored in the plugin bundle. The scratch guard
# above still holds everywhere else. See the self-communicate SKILL.md `## Local adapter` block.
!/plugin/mage/skills/**/*.local.md

# dispatched-agent scratch briefs — belong in scratchpad, not the book tree; guards against a
# stray brief being accidentally `git add -A`'d into a commit (does not match the real tracked
# _design docs — editorial-run-results, model-sync-DRAFT, evidence-study-design — none end in -brief)
book/_design/*-brief*.md

# local-only publisher pitches (not published, not committed)
/book/_pitch/

# combined print-HTML intermediate for the PDF build (regenerated by `build_book.py --pdf`)
/book/_print/

# IR→Typst SPIKE emitter output (the .typ markup + compiled .pdf) — a de-risking proof-of-concept, not
# the production PDF path. Regenerated by `book/book_typst.py`; multi-file + binary, never committed.
/book/_typst/

# build-time mermaid→SVG render cache (content-hashed; regenerated by build_book.py via mmdc)
/book/.mermaid-svg-cache/

# The rendered book PDF is a CI-GENERATED, Pages-PUBLISHED artifact — NOT committed to git (avoids a
# multi-MB binary in history). `build_book.py --pdf` regenerates it locally (gitignored preview);
# the Pages workflow regenerates + publishes it at /book/mage-book.pdf on the deployed site.
/book/mage-book.pdf
# Per-section review-aid PDFs (FrontMatter / Part1-6 / BackMatter / Appendices) — emitted by a local
# `build_book.py --pdf` alongside the full book, same gitignore posture as mage-book.pdf (created,
# never committed; not rendered in CI).
/book/mage-book-*.pdf
# The MAGE "full writing stack" export — a concatenation of the writing-stack source files, emitted by
# book/build_writing_style.py on every build (see build_book.py). A derived build artifact, same posture
# as mage-book.pdf: created, never committed.
/book/mage-writing-style.md

# Node build tooling for the PDF render (Puppeteer). package.json + package-lock.json ARE tracked (CI
# runs `npm ci`); the installed tree is not.
/book/node_modules/

# scratch axe/screenshot helper — never ship
/book/_shot.mjs

# Terseness-audit worksheets (review artifacts, not shipped)
terseness-recs/

# Raw transcript source audio/video (multi-MB binaries; transcripts are the shipped artifact)
transcript-sources/

# book-models/ agent scratch + review artifacts — kept local, MUST NOT orphan the build gate
# or leak into publish-staging (both bit us this session: a triptych .html orphaned the build,
# voice drafts needed a manual pre-publish move). Legit book-models files (models-view.html,
# *.json, *.py, SITE-*.md, DESIGN.md, DRAIN-PLAN.md, outcomes-draft.md) are NOT matched.
book-models/voice-*
book-models/voice-candidates/
book-models/*-review-*.md
book-models/gap-report-*

# Touchstone reference PDFs (copyrighted books, kept locally for comparison — NEVER commit/publish)
/_reference/
book/_design/visual-aids.html
book/_design/drafts/

# d2-pilot review HTMLs are local artifacts, not served pages
book/d2-pilot/*.html

# Teach-with-MAGE course companion — build outputs (never committed; regenerated by CI / on demand).
# (gitignore has no inline comments — keep each pattern on its own line.)
# course bundle archives (tools/build_course_bundle.py)
/dist/
# stray local `mkdocs build` output if run without -d
/site/site/
# local site toolchain venv (site/requirements.txt)
/site/.venv/
