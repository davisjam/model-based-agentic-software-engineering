% Monochrome publisher candidates; all dimensions are final print dimensions.
\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{mage-figures.sty}[2026/10/17 MAGE monochrome figure trials]
% Keep mathematical symbols scalable at the same authored sizes as figure prose.
\RequirePackage{fix-cm}
\RequirePackage{fontspec}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{hyperref}
\hypersetup{hidelinks,pageanchor=false}
% Standalone sources retain readable references. The pool records link rectangles
% for the book assembler, which supplies real internal destinations.
\providecommand{\magebookref}[2]{\ifdefined\magecollectlinks\href{magebook:#1}{#2}\else#2\fi}
\usetikzlibrary{arrows.meta,positioning,fit,calc,backgrounds,patterns,shapes.geometric,decorations.pathreplacing}
\usepgfplotslibrary{groupplots}
\pgfplotsset{compat=1.18}
% A figure included in a book inherits that edition's body family. The cropped
% standalone pool uses the same MAGE profile as house.sty.
\ifdefined\bookbodyfont\else
  \input{latex/book-fonts.tex}
  \bookmagefontprofile
\fi
\let\magefigurefont\bookbodyfont
\tikzset{every picture/.style={font=\magefigurefont\fontsize{10}{12}\selectfont,color=black},>=Latex}
\pgfplotsset{mage plot/.style={cycle list name=black white,every node near coord/.append style={black},every axis plot post/.append style={mark options={draw=black,fill=black}},width=14cm,height=6cm,scale only axis,axis lines*=left,axis line style={black!50},tick label style={font=\magefigurefont\fontsize{10}{12}\selectfont},scaled ticks=false,ymajorgrids,grid style={black!20,dotted},legend style={draw=none,font=\magefigurefont\fontsize{9}{11}\selectfont},legend cell align=left}}
