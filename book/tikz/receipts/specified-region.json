  },
  "required_terms": [
    "Engineering obligation Consequential distinctions that must be preserved",
    "Scaffolding Additional structure this agent needs to interpret and satisfy the obligation reliably",
    "Degrees of freedom Implementation choices left to the agent",
    "Obligation boundary Determined by the problem",
    "Specification boundary Determined by obligation and agent capability",
    "Stronger agents need less scaffolding"
  ],
  "bw_encoding": "Only the fixed engineering obligation uses 8%; scaffolding, free choices and outer territory are white.",
