  "archive_on_acceptance": true,
  "visual_proposition": "One proposed change is admitted only when a gate uses the relevant check results and architectural rule; the constraint narrows available implementation paths and the sensor supplies evidence about behavior that remains possible.",
  "semantic_structure": {
    "candidate": "proposed reporting change",
    "constraint": "module boundary exposes billing API client and excludes private database connector in checked imports",
    "sensor": "instrumented tests record caller, attempted destination, and outcome, including direct database attempts through generic networking",
    "model": "reporting uses billing API; direct billing database access forbidden",
    "gate": "checks build results and recorded interactions against architectural rule, returns change for repair on required failure or missing evidence",
    "outcomes": [
      "accepted change",
      "returned for repair"
    ]
  },
  "topology": "Direct candidate spine plus parallel constraint/sensor branches; separate evidence and policy inputs converge at gate; gate branches to accepted candidate or repair.",
  "forbidden_inferences": [
    "Constraint, sensor, and gate are not exclusive products or mandatory sequential stages.",
    "The sensor does not prevent the database connection.",
    "This example does not define constraints as static or sensors as dynamic.",
    "Passing selected checks does not establish all possible executions conform.",
    "An architectural model does not enforce its rule merely by existing."
  ],
  "rhetorical_hierarchy": [
    "the proposed reporting change",
    "the distinct constraint and sensor functions around that change",
    "the merge gate combining inputs and controlling admission"
  ],
  "realization_reason": "Explicit user request for paired editable SVG and native TikZ, matching the existing book artifacts. Fixed placement preserves the distinct candidate spine and separate evidence convergence without crossed connectors.",
  "caption": "Governance around a proposed change. Module restrictions limit the implementation; instrumented tests produce evidence; the merge gate checks the required results before accepting the change. The checks' coverage limits the assurance they provide.",
